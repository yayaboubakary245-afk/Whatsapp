<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/campus_text">

    <TextView
        android:id="@+id/tvCallPeer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Appel Campus WebRTC"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connexion P2P..."
        android:textColor="#CBD5E1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Muet"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnSpeaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Haut-parleur"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnHangup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raccrocher"
            android:backgroundTint="#DC2626" />
    </LinearLayout>
</LinearLayout>
